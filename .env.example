# Copy this file to ".env" (same folder) and fill in your values. ".env" is git-ignored; never commit or share it.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# The patient check-in chat agent (a different agent from the clinic dictation one above). Setup: elevenlabs/chat_agent_setup.md
ELEVENLABS_CHAT_AGENT_ID=
GEMINI_API_KEY=
# Needed if you share the site over the internet (e.g. a Cloudflare tunnel). Pick a long random string. Open the site once with ?key=THAT_STRING.
ACCESS_TOKEN=
# optional
# GEMINI_MODEL=gemini-3.5-flash-lite
# PORT=8780
# Tiger Data (Tiger Cloud): paste the service connection string to store readings in TimescaleDB instead of a local file.
# Looks like postgres://tsdbadmin:PASSWORD@xxxx.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
DATABASE_URL=
# Only if the server reports a certificate error:
# DATABASE_SSL=no-verify
